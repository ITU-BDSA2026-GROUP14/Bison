name: release
on:
  push:
    tags: ['v*']
permissions:
  contents: write
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: Restore
        run: dotnet restore Bison.CLI/Bison.csproj

      - name: Build
        run: dotnet build Bison.CLI/Bison.csproj -c Release --no-restore

      - name: Test
        run: dotnet test Bison.CLI/Bison.csproj -c Release --no-build --verbosity normal

      - name: Publish and zip Windows
        run: |
          dotnet publish Bison.CLI/Bison.csproj -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=none -o out/win-x64
          cd out/win-x64 && zip -r ../../Bison-win-x64.zip .

      - name: Publish and zip macOS
        run: |
          dotnet publish Bison.CLI/Bison.csproj -c Release -r osx-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=none -o out/osx-x64
          cd out/osx-x64 && zip -r ../../Bison-osx-x64.zip .

      - name: Publish and zip Linux
        run: |
          dotnet publish Bison.CLI/Bison.csproj -c Release -r linux-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=none -o out/linux-x64
          cd out/linux-x64 && zip -r ../../Bison-linux-x64.zip .

      - name: Create GitHub release
        uses: softprops/action-gh-release@v3
        with:
          files: Bison-*.zip
          generate_release_notes: true

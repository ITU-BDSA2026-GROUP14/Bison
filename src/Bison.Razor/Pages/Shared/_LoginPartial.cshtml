@using Microsoft.AspNetCore.Identity
@using Bison.Razor
@inject SignInManager<Author> SignInManager
@inject UserManager<Author> UserManager

<div class=navigation>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div>
            <a href="/@(UserManager.GetUserId(User))">My Observations</a> |
            <a href="/">Public Observations</a> |
            <a class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })"
               asp-area="Identity" method="post">Logout [@(User.Identity.Name)]</a>
        </div>
    }
    else
    {
        <div>
            <a href="/">Public Observations</a> |
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">register</a>
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </div>
    }
</div>
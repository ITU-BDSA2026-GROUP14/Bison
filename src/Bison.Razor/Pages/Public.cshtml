@page "/"
@model Bison.Razor.Initial.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline, page @Model.CurrentPage</h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a href="?page=@(Model.CurrentPage - 1)">&laquo; Previous</a>
        }
        
        @if (Model.Observations.Count == DBFacade.PageSize)
        {
            <a href="?page=@(Model.CurrentPage + 1)">Next &raquo;</a>
        }
    </div>
</div>

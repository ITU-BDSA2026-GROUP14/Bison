@page "/"
@model Bison.Razor.Initial.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <h3> What did you spot today? </h3>
        <form method="post" enctype="multipart/form-data">
        <input type="text" name="Text">
        <input type ="file" name="Picture" accept="image/*">
        <input type ="submit" value="Share">
        </form>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.AuthorId">@obs.AuthorName</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.PubDate</small>
                    </p>
                    @if (obs.HasPicture)
            {
                    <img class="observation-picture" src="/ob/@(obs.Id)?handler=Picture" alt="Picture of the observation">
            }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
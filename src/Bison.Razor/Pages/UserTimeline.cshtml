@page "/{UserId}"
@using Bison.Razor
@model Bison.Razor.Initial.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("UserId");
}

<div>
    <h2> @(Model.Author.UserName ?? "Unknown User")'s Observations page @Model.CurrentPage</h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@ob.UserId">@ob.UserName</a>
                        </strong>
                        @ob.Text
                        <small>&mdash; @ob.PubDate &middot; <a href="/ob/@ob.Id">Comments &amp; proposals</a></small>
                    </p>
                    @if (ob.ImageId is not null)
            {
                    <img class="observation-picture" src="/ob/@(ob.ImageId)?handler=Picture" alt="Picture of the observation">
            }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }

    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a href="?page=@(Model.CurrentPage - 1)">&laquo; Previous</a>
        }

        @if (Model.Observations.Count == 32)
        {
            <a href="?page=@(Model.CurrentPage + 1)">Next &raquo;</a>
        }
    </div>
</div>

@page "/{authorId:int}"
@using Bison.Razor
@model Bison.Razor.Initial.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("authorId");
}

<div>
    <h2> @routeName's Observations page @Model.CurrentPage</h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@ob.AuthorId">@ob.AuthorName</a>
                        </strong>
                        @ob.Text
                        <small>&mdash; @ob.PubDate</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }

    ass="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="?page=@(Model.CurrentPage - 1)">&laquo; Previous</a>
    }
        
    @if (Model.Observations.Count == BisonDBContext.pageSize)
    {
        <a href="?page=@(Model.CurrentPage + 1)">Next &raquo;</a>
    }
</div>
</div>

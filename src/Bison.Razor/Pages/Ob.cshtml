@page "/ob/{id:int?}"
@model Bison.Razor.Initial.Pages.ObModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}
<div class=navigation>
    @if (User.Identity.IsAuthenticated)
    {
        <div>
            <a href="/@(User.Identity.Name)">My Observations</a> |
            <a href="/">Public Observations</a> |
            <a ... >Logout [@(User.Identity.Name)]</a>
        </div>
    }
    else
    {
        <div>
            <a href="/">Public Observations</a> |
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">register</a>
            <a ... >Login</a>
        </div>
    }
</div>
<div>
    <h2>Observation</h2>

    <ul class="observations">
        <li>
            <p>
                <strong><a href="/@Model.Observation!.AuthorId">@Model.Observation.AuthorName</a></strong>
                @Model.Observation.Text
                <small>&mdash; @Model.Observation.PubDate</small>
            </p>
        </li>
    </ul>

    <h3>Proposals</h3>
    @if (Model.Proposals.Any())
    {
        <ul class="observations">
            @foreach (var proposal in Model.Proposals)
            {
                <li>
                    <p>
                        <strong><a href="/@proposal.AuthorId">@proposal.AuthorName</a></strong>
                        @proposal.Text
                        <small>&mdash; @proposal.PubDate</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no proposals so far.</em>
    }

    <h3>Comments</h3>
    @if (Model.Comments.Any())
    {
        <ul class="observations">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <p>
                        <strong><a href="/@comment.AuthorId">@comment.AuthorName</a></strong>
                        @comment.Text
                        <small>&mdash; @comment.PubDate</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments so far.</em>
    }
</div>
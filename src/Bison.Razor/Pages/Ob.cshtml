@page "/ob/{id:int?}"
@model Bison.Razor.Initial.Pages.ObModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>

    <ul class="observations">
        <li>
            <p>
                <strong><a href="/@Model.Observation!.UserId">@Model.Observation.UserName</a></strong>
                @Model.Observation.Text
                <small>&mdash; @Model.Observation.PubDate</small>
            </p>
            @if (Model.Observation.ImageId is not null)
        {
            <img class="observation-picture" src="/ob/@(Model.Observation.ImageId)?handler=Picture" alt="Picture of the observation">
        }
        </li>
    </ul>

    <h3>Proposals</h3>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>What do you think it is, @(User.Identity.Name)?</h3>
            <form method="post" asp-page-handler="Proposal" asp-route-id="@Model.Observation.Id">
                <p>
                    <select asp-for="ProposalTaxonId">
                        <option value="">Choose a species or group</option>
                        @foreach (var taxon in Model.Taxa.Where(t => t.TaxonName != null))
                        {
                            <option value="@taxon.TaxonId">@taxon.TaxonName</option>
                        }
                    </select>
                </p>
                <input style="float: left" type="text" asp-for="ProposalText" placeholder="Why do you think so? (optional)">
                <input type="submit" value="Propose">
            </form>
            <span asp-validation-for="ProposalTaxonId"></span>
        </div>
    }

    @if (Model.Proposals.Any())
    {
        <ul class="observations">
            @foreach (var proposal in Model.Proposals)
            {
                <li>
                    <p>
                        <strong><a href="/@proposal.UserId">@proposal.UserName</a></strong>
                        @proposal.Text
                        <small>&mdash; @proposal.PubDate</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no proposals so far.</em>
    }

    <h3>Comments</h3>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>What do you want to say, @(User.Identity.Name)?</h3>
            <form method="post" asp-page-handler="Comment" asp-route-id="@Model.Observation.Id">
                <input style="float: left" type="text" asp-for="CommentText">
                <input type="submit" value="Comment">
            </form>
            <span asp-validation-for="CommentText"></span>
        </div>
    }
    
    @if (Model.Comments.Any())
    {
        <ul class="observations">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <p>
                        <strong><a href="/@comment.UserId">@comment.UserName</a></strong>
                        @comment.Text
                        <small>&mdash; @comment.PubDate</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments so far.</em>
    }
</div>
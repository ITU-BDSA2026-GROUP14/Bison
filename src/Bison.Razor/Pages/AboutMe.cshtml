@page
@model Bison.Razor.Initial.Pages.AboutMeModel
@{
    ViewData["Title"] = "About me";
    Layout = "Shared/_Layout";
}
<div>
    <h2>About Me</h2>
    <p>This is all information Bison stores about you.</p>
    
    <h3>Account</h3>
    <ul> 
        <li>Username: @Model.Me.UserName</li>
        <li>Email: @Model.Me.Email (@(Model.Me.EmailConfirmed ? "confirmed" : "not confirmed"))</li>
        <li>Phone number: @(Model.Me.PhoneNumber ?? "none")</li>
        <li>Two-factor login: @(Model.Me.TwoFactorEnabled ? "on" : "off")</li>
        <li>Password: @(Model.Me.PasswordHash is null ? "none (you log in with GitHub)" : "stored as a secure hash")</li>
        <li>User id: @Model.Me.Id</li>
    </ul>

    <h3> Linked logins</h3>
    @if (Model.Logins.Any())
    {
        <ul>
            @foreach (var login in Model.Logins)
            {
                <li>@login.ProviderDisplayName</li>
            }
        </ul>
    }
    else
    {
        <p>None</p>
    }
</div>